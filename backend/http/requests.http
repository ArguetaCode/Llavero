### Health
GET http://localhost:8080/api/health

### Register
POST http://localhost:8080/api/auth/register
Content-Type: application/json

{
  "email": "persona@example.test",
  "displayName": "Persona Demo",
  "password": "remote-password-demo"
}

### Login
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{
  "email": "persona@example.test",
  "password": "remote-password-demo"
}

### Me
GET http://localhost:8080/api/auth/me
Authorization: Bearer {{token}}

### Create vault
POST http://localhost:8080/api/vaults
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "clientVaultId": "local-vault-id-demo",
  "displayName": "Personal",
  "encryptedPayload": "payload-cifrado-ficticio",
  "payloadVersion": 1
}

### List vaults
GET http://localhost:8080/api/vaults
Authorization: Bearer {{token}}

### Get vault
GET http://localhost:8080/api/vaults/{{vaultId}}
Authorization: Bearer {{token}}

### Update vault
PUT http://localhost:8080/api/vaults/{{vaultId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "clientVaultId": "local-vault-id-demo",
  "displayName": "Personal actualizada",
  "encryptedPayload": "payload-cifrado-ficticio-actualizado",
  "payloadVersion": 2
}

### Delete vault
DELETE http://localhost:8080/api/vaults/{{vaultId}}
Authorization: Bearer {{token}}
